# ===================================================================
# TORNADOES JOB ERP - Environment Configuration
# ===================================================================
# Copiez ce fichier dans .env et remplissez les valeurs

# -------------------------------------------------------------------
# DATABASE CONFIGURATION
# -------------------------------------------------------------------
# Pour développement local avec Docker (port 5433)
DB_URL=jdbc:postgresql://localhost:5433/tornadoes_job_erp
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Pour PostgreSQL local (port 5432)
# DB_URL=jdbc:postgresql://localhost:5432/tornadoes_job_erp
# DB_USERNAME=tornadoes_user
# DB_PASSWORD=your_secure_password

# Pour Neon DB (cloud)
# DB_URL=jdbc:postgresql://ep-xxx.region.aws.neon.tech/tornadoes_job_erp?sslmode=require
# DB_USERNAME=tornadoes_user
# DB_PASSWORD=your_neon_password

# -------------------------------------------------------------------
# JWT SECURITY
# -------------------------------------------------------------------
# Générez un secret fort : openssl rand -base64 32
JWT_SECRET=tornadoes_job_secret_key_change_this_in_production_123456789

# Token expiration (en millisecondes)
JWT_ACCESS_EXPIRATION=900000      # 15 minutes
JWT_REFRESH_EXPIRATION=604800000  # 7 days

# -------------------------------------------------------------------
# SERVER CONFIGURATION
# -------------------------------------------------------------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# -------------------------------------------------------------------
# CLOUDINARY (File Upload - Optionnel)
# -------------------------------------------------------------------
# Créez un compte gratuit sur https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# -------------------------------------------------------------------
# EMAIL CONFIGURATION (Optionnel)
# -------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# SMTP_FROM=noreply@tornadoesjob.com

# -------------------------------------------------------------------
# REDIS CACHE (Optionnel)
# -------------------------------------------------------------------
# REDIS_HOST=localhost
# REDIS_PORT=6379

# -------------------------------------------------------------------
# LOGGING
# -------------------------------------------------------------------
# Niveaux: DEBUG, INFO, WARN, ERROR
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_COMPANY_ERP=DEBUG
