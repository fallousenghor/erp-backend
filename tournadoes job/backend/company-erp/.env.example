# COMPANY ERP - Environment Variables Example
# Copy to .env and fill values

# Database (Neon Postgres)
DB_URL=jdbc:postgresql://your-neon-host:5432/neondb?sslmode=require
DB_USERNAME=your_username
DB_PASSWORD=your_secure_password

# JWT
JWT_SECRET=your-512-bit-secret-key-generated-with-openssl-rand---base64-64
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Server
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Cloudinary (for documents)
CLOUDINARY_CLOUD_NAME=demo
CLOUDINARY_API_KEY=your_key
CLOUDINARY_API_SECRET=your_secret
