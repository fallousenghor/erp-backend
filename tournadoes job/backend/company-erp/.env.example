# ==============================================================================
# COMPANY ERP — Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ==============================================================================

# Spring Profile (dev | prod)
SPRING_PROFILES_ACTIVE=dev

# Database
DB_URL=jdbc:postgresql://localhost:5432/company_erp
DB_USERNAME=erp_user
DB_PASSWORD=your_secure_password_here
DB_POOL_SIZE=20

# JWT Security
# Generate with: openssl rand -hex 64
JWT_SECRET=your_very_long_secret_key_at_least_256_bits_here
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Server
SERVER_PORT=8080

# CORS
CORS_ORIGINS=http://localhost:3000

# Flyway (for manual migrations via CLI)
FLYWAY_URL=jdbc:postgresql://localhost:5432/company_erp
FLYWAY_USER=erp_user
FLYWAY_PASSWORD=your_secure_password_here
